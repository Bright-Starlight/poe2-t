; Engine configuration file.
; It's best edited using the editor UI and not directly,
; but it can also be edited by text.

config_version=5

[application]

config/name="Pixel ARPG Loot"
config/description="A 2D pixel-art ARPG idle and loot game."
config/version="0.1.0"
run/main_scene="res://scenes/text_ui/text_main.tscn"
config/features=PackedStringArray("4.3", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

DataLoader="*res://scripts/core/data_loader.gd"
EventBus="*res://scripts/core/event_bus.gd"
GameManager="*res://scripts/core/game_manager.gd"
InventoryManager="*res://scripts/item/inventory_manager.gd"
CraftingManager="*res://scripts/crafting/crafting_manager.gd"
TalentManager="*res://scripts/talent/talent_manager.gd"
LootFilterManager="*res://scripts/loot/loot_filter_manager.gd"
WaystoneManager="*res://scripts/map/waystone_manager.gd"

[display]

window/size/viewport_width=960
window/size/viewport_height=540
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[gui]

theme/custom="res://assets/ui/default_theme.tres"

